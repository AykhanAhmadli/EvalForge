# Local PostgreSQL defaults used by Docker Compose.
POSTGRES_DB=evalforge
POSTGRES_USER=evalforge
POSTGRES_PASSWORD=evalforge

# Use localhost for local Python processes. Docker Compose overrides this to use the db service.
DATABASE_URL=postgresql+psycopg://evalforge:evalforge@localhost:5432/evalforge

ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Tests and local development use the deterministic fake provider by default.
DEFAULT_PROVIDER=fake
FAKE_PROVIDER_SEED=evalforge-local

# Set API_AUTH_REQUIRED=true outside local development. API_KEYS are runtime secrets;
# map each key to an allowed workspace with key:workspace-uuid pairs.
API_AUTH_REQUIRED=false
API_KEYS=
API_KEY_WORKSPACES=
MAX_REQUEST_BYTES=10485760
MAX_UPLOAD_BYTES=10485760

# CLI/frontend runtime credentials; never commit populated values.
EVALFORGE_API_KEY=
EVALFORGE_WORKSPACE_ID=
VITE_API_KEY=
VITE_WORKSPACE_ID=
